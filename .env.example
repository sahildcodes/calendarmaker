# Copy this file to .env for local development. Never commit the populated .env file.
PRODUCTION=false
PUBLIC_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Generate long, unique values for these settings.
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET_KEY=replace-with-at-least-32-random-characters

# Configure either these two variables or a local, ignored credentials.json file.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
